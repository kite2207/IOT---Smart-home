    {
        "id": "22cc504cc620c628",
        "type": "function",
        "z": "a26aa76f5d84d03a",
        "name": "function 9",
        "func": "const result = msg.payload || {};\nconst status = Number(msg.statusCode || 500);\n\n// Supabase của bạn trả user trực tiếp; vẫn hỗ trợ cả dạng result.user.\nconst user = result.user || (result.id ? result : null);\n\nif (status >= 200 && status < 300 && user) {\n    msg.statusCode = 201;\n\n    msg.payload = {\n        ok: true,\n        message: result.confirmation_sent_at\n            ? \"Đăng ký thành công. Hãy kiểm tra email để xác nhận tài khoản.\"\n            : \"Đăng ký thành công. Bạn có thể đăng nhập ngay.\",\n        user: {\n            id: user.id,\n            email: user.email\n        }\n    };\n} else {\n    msg.statusCode = status >= 400 ? status : 400;\n\n    msg.payload = {\n        ok: false,\n        message:\n            result.msg ||\n            result.message ||\n            result.error_description ||\n            result.error?.message ||\n            \"Không thể đăng ký tài khoản.\"\n    };\n}\n\nreturn msg;",
