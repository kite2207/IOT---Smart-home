    {
        "id": "92ad155650722306",
        "type": "function",
        "z": "a26aa76f5d84d03a",
        "name": "function 7",
        "func": "const { full_name, email, password, re_password } = msg.payload || {};\n\nif (!email || !password || !re_password) {\n    msg.statusCode = 400;\n    msg.payload = { ok: false, message: \"Vui lòng nhập đủ thông tin.\" };\n    return [null, msg];\n}\n\nif (password !== re_password) {\n    msg.statusCode = 400;\n    msg.payload = { ok: false, message: \"Mật khẩu nhập lại không khớp.\" };\n    return [null, msg];\n}\n\nif (password.length < 6) {\n    msg.statusCode = 400;\n    msg.payload = { ok: false, message: \"Mật khẩu phải có ít nhất 6 ký tự.\" };\n    return [null, msg];\n}\n\nmsg.method = \"POST\";\nmsg.url = env.get(\"SUPABASE_URL\") + \"/auth/v1/signup\";\nmsg.headers = {\n    \"apikey\": env.get(\"SUPABASE_ANON_KEY\"),\n    \"Content-Type\": \"application/json\"\n};\nmsg.payload = {\n    email,\n    password,\n    data: { full_name }\n};\n\nreturn [msg, null];",
