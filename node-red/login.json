    {
        "id": "e872453333ea4634",
        "type": "function",
        "z": "a26aa76f5d84d03a",
        "name": "function 8",
        "func": "const result = msg.payload || {};\nconst status = Number(msg.statusCode || 500);\n\nif (status >= 200 && status < 300 && result.access_token) {\n    msg.statusCode = 200;\n    msg.payload = {\n        ok: true,\n        message: \"Đăng nhập thành công.\",\n        access_token: result.access_token,\n        refresh_token: result.refresh_token,\n        user: {\n            id: result.user.id,\n            email: result.user.email\n        }\n    };\n} else {\n    msg.statusCode = status >= 400 ? status : 401;\n    msg.payload = {\n        ok: false,\n        message: result.msg || result.message || \"Email hoặc mật khẩu không đúng.\"\n    };\n}\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
