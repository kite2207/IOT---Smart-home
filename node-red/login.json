    {
        "id": "6e26cc3cad629303",
        "type": "function",
        "z": "a26aa76f5d84d03a",
        "name": "function 6",
        "func": "const { email, password } = msg.payload || {};\n\nif (!email || !password) {\n    msg.statusCode = 400;\n    msg.payload = {\n        ok: false,\n        message: \"Vui lòng nhập email và mật khẩu.\"\n    };\n    return [null, msg]; // đi thẳng tới http response\n}\n\nmsg.method = \"POST\";\nmsg.url = env.get(\"SUPABASE_URL\") +\n    \"/auth/v1/token?grant_type=password\";\n\nmsg.headers = {\n    \"apikey\": env.get(\"SUPABASE_ANON_KEY\"),\n    \"Content-Type\": \"application/json\"\n};\n\nmsg.payload = { email, password };\n\nreturn [msg, null]; // gửi sang http request",
        "outputs": 2,
        "timeout": 0,
