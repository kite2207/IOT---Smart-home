    {
        "id": "45d7e44ed73498ab",
        "type": "ui-template",
        "z": "8d4792cf5dad1653",
        "group": "802dbdbb1171fb0f",
        "page": "",
        "ui": "",
        "name": "",
        "order": 1,
        "width": 0,
        "height": 0,
        "head": "",
        "format": "<template>\n  <div class=\"chat-widget\">\n    <button class=\"chat-toggle-btn\" @click=\"toggleChat\">\n      <span v-if=\"!isOpen\">💬</span>\n      <span v-else>✕</span>\n    </button>\n\n    <div class=\"chat-window\" v-if=\"isOpen\">\n      <div class=\"chat-header\">\n        <span>🤖 Trợ lý AI</span>\n        <button class=\"close-btn\" @click=\"toggleChat\">✕</button>\n      </div>\n\n      <div class=\"chat-body\" ref=\"chatBody\">\n        <div v-for=\"(m, i) in messages\" :key=\"i\" :class=\"['chat-msg', m.role]\">\n          <div class=\"bubble\">{{ m.text }}</div>\n        </div>\n\n        <div v-if=\"isTyping\" class=\"chat-msg bot\">\n          <div class=\"bubble typing\">\n            <span class=\"dot\"></span>\n            <span class=\"dot\"></span>\n            <span class=\"dot\"></span>\n          </div>\n        </div>\n      </div>\n\n      <div class=\"chat-footer\">\n        <input\n          v-model=\"inputText\"\n          @keyup.enter=\"sendMessage\"\n          placeholder=\"Nhập tin nhắn...\"\n          :disabled=\"isTyping\"\n        />\n        <button @click=\"sendMessage\" :disabled=\"isTyping || !inputText.trim()\">➤</button>\n      </div>\n    </div>\n  </div>\n\n  <div\n    style=\"position:fixed; top:0; left:0; background:yellow; z-index:99999; font-size:10px; max-width:300px; word-break:break-all;\">\n    DEBUG msg: {{ msg }}\n  </div>\n</template>\n\n<script>\n  export default {\n  data() {\n    return {\n      isOpen: false,\n      inputText: '',\n      isTyping: false,\n      messages: [\n        {\n          role: 'bot',\n          text: 'Tôi là AI Chatbot của dự án SafeHome, tôi có thể giúp gì cho bạn? 😘'\n        }\n      ]\n    }\n  },\n\n  mounted() {\n    this.$socket.on('msg-input:' + this.id, (msg) => {\n      if (msg?.payload === undefined || msg.payload === null) return\n\n      const text = typeof msg.payload === 'string'\n        ? msg.payload\n        : JSON.stringify(msg.payload)\n\n      this.isTyping = false\n      this.messages.push({ role: 'bot', text })\n      this.$nextTick(() => this.scrollToBottom())\n    })\n  },\n\n  methods: {\n    toggleChat() {\n      this.isOpen = !this.isOpen\n      if (this.isOpen) this.$nextTick(() => this.scrollToBottom())\n    },\n\n    sendMessage() {\n      const text = this.inputText.trim()\n      if (!text || this.isTyping) return\n\n      this.messages.push({ role: 'user', text })\n      this.inputText = ''\n      this.isTyping = true\n      this.$nextTick(() => this.scrollToBottom())\n\n      this.send({ payload: text })\n    },\n\n    scrollToBottom() {\n      const el = this.$refs.chatBody\n      if (el) el.scrollTop = el.scrollHeight\n    }\n  }\n}\n</script>\n\n<style scoped>\n  .chat-widget {\n    position: fixed;\n    bottom: 20px;\n    right: 20px;\n    z-index: 9999;\n    font-family: Arial, sans-serif;\n  }\n\n  .chat-toggle-btn {\n    width: 56px;\n    height: 56px;\n    border-radius: 50%;\n    border: none;\n    background: #2b7de9;\n    color: #fff;\n    font-size: 24px;\n    cursor: pointer;\n    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.3);\n  }\n\n  .chat-window {\n    position: absolute;\n    bottom: 70px;\n    right: 0;\n    width: 320px;\n    height: 420px;\n    background: #fff;\n    border-radius: 10px;\n    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.25);\n    display: flex;\n    flex-direction: column;\n    overflow: hidden;\n  }\n\n  .chat-header {\n    background: #2b7de9;\n    color: #fff;\n    padding: 10px 12px;\n    display: flex;\n    justify-content: space-between;\n    align-items: center;\n    font-weight: bold;\n  }\n\n  .close-btn {\n    background: none;\n    border: none;\n    color: #fff;\n    cursor: pointer;\n    font-size: 16px;\n  }\n\n  .chat-body {\n    flex: 1;\n    padding: 10px;\n    overflow-y: auto;\n    background: #f4f6f8;\n  }\n\n  .chat-msg {\n    display: flex;\n    margin-bottom: 8px;\n  }\n\n  .chat-msg.user {\n    justify-content: flex-end;\n  }\n\n  .chat-msg.bot {\n    justify-content: flex-start;\n  }\n\n  .bubble {\n    max-width: 75%;\n    padding: 8px 12px;\n    border-radius: 14px;\n    font-size: 14px;\n    line-height: 1.4;\n    word-wrap: break-word;\n  }\n\n  .chat-msg.user .bubble {\n    background: #2b7de9;\n    color: #fff;\n    border-bottom-right-radius: 2px;\n  }\n\n  .chat-msg.bot .bubble {\n    background: #e4e6eb;\n    color: #000;\n    border-bottom-left-radius: 2px;\n  }\n\n  .typing {\n    display: flex;\n    gap: 4px;\n    align-items: center;\n  }\n\n  .dot {\n    width: 6px;\n    height: 6px;\n    border-radius: 50%;\n    background: #888;\n    animation: blink 1.4s infinite both;\n  }\n\n  .dot:nth-child(2) {\n    animation-delay: 0.2s;\n  }\n\n  .dot:nth-child(3) {\n    animation-delay: 0.4s;\n  }\n\n  @keyframes blink {\n\n    0%,\n    80%,\n    100% {\n      opacity: 0.2;\n    }\n\n    40% {\n      opacity: 1;\n    }\n  }\n\n  .chat-footer {\n    display: flex;\n    padding: 8px;\n    border-top: 1px solid #ddd;\n    background: #fff;\n  }\n\n  .chat-footer input {\n    flex: 1;\n    border: 1px solid #ccc;\n    border-radius: 20px;\n    padding: 8px 12px;\n    outline: none;\n    font-size: 14px;\n  }\n\n  .chat-footer button {\n    margin-left: 6px;\n    width: 36px;\n    height: 36px;\n    border-radius: 50%;\n    border: none;\n    background: #2b7de9;\n    color: #fff;\n    cursor: pointer;\n  }\n\n  .chat-footer button:disabled {\n    background: #aac4ea;\n    cursor: not-allowed;\n  }\n</style>",
