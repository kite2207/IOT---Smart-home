        "func": "let data = msg.payload;\n\nif (typeof data === \"string\") {\n    data = JSON.parse(data);\n}\n\nif (data.is_anomaly === true) {\n    let time = new Date().toLocaleTimeString(\"vi-VN\", {\n        hour: \"2-digit\",\n        minute: \"2-digit\"\n    });\n\n    msg.payload = time;\n\n    flow.set(\"latest_anomaly\", msg.payload);\n\n    return msg;\n}\n\nreturn null;",
