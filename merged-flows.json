  {
    "id": "1053d375fc8964e1",
    "type": "function",
    "z": "8d4792cf5dad1653",
    "name": "function 4",
    "func": "// 1. Kiểm tra msg.payload có tồn tại không trước, tránh crash khi mất mạng/timeout\nif (!msg.payload) {\n    msg.payload = \"Hệ thống AI đang gặp sự cố: không nhận được phản hồi.\";\n    return msg;\n}\n\n// 2. Bắt riêng lỗi 429 (Quá tải giới hạn API của Google)\nif (msg.statusCode == 429 || (msg.payload && msg.payload.error && msg.payload.error.code == 429)) {\n    msg.payload = \"Trợ lý đang bận xử lý do hệ thống quá tải, vui lòng thử lại sau 1 phút nhé.\";\n    return msg;\n}\n\n// 3. Trích xuất dữ liệu thành công nếu cấu trúc trả về đúng chuẩn của Gemini\nif (msg.payload.candidates && msg.payload.candidates.length > 0) {\n    msg.payload = msg.payload.candidates[0].content.parts[0].text;\n} else {\n    // 4. Bắt các lỗi API khác từ Google (VD: 400 sai định dạng, 403 sai key, 404 sai model...)\n    let errorDetail = msg.payload.error ? msg.payload.error.message : \"Lỗi không xác định\";\n    msg.payload = \"Hệ thống AI đang gặp sự cố: \" + errorDetail;\n}\n\nreturn msg;",
    "outputs": 1,
