  {
    "id": "fn-build-env-log",
    "type": "function",
    "z": "tab-supabase",
    "name": "Build environment_log",
    "func": "var temp = flow.get('latestTemp');\nvar hum  = flow.get('latestHum');\nif (temp === undefined || hum === undefined) {\n  node.warn('Chua co du lieu DHT, bo qua.');\n  return null;\n}\nmsg._table  = '/rest/v1/environment_log';\nmsg.payload = JSON.stringify({\n  temperature: temp,\n  humidity:    hum,\n  fan_state:   flow.get('latestFan') || false\n});\nreturn msg;",
    "outputs": 1,
    "x": 420,
    "y": 380,
    "wires": [
      [
        "fn-supabase-headers"
      ]
    ]
  },
