    "id": "supabase-config",
    "type": "function",
    "z": "tab-supabase",
    "name": "Supabase Config",
    "func": "flow.set('SUPABASE_URL',      'https://wfkesifcfgajgymipqcd.supabase.co');\nflow.set('SUPABASE_ANON_KEY', 'sb_publishable_KDECMGj5-HIlQGGUUrYdHg_7b-VojuY');\nreturn msg;",
    "outputs": 1,
    "initialize": "flow.set('SUPABASE_URL',      'https://wfkesifcfgajgymipqcd.supabase.co');\nflow.set('SUPABASE_ANON_KEY', 'sb_publishable_KDECMGj5-HIlQGGUUrYdHg_7b-VojuY');\nflow.set('emailEnabled', false);",
