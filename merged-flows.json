  {
    "id": "fn-format-email",
    "type": "function",
    "z": "tab-email",
    "name": "Format Email & Log",
    "func": "var ownerEmail = 'YOUR_EMAIL@gmail.com';\nif (Array.isArray(msg.payload) && msg.payload.length > 0 && msg.payload[0].email) {\n    ownerEmail = msg.payload[0].email;\n}\n\nvar data = msg._rfid_data || {};\nvar now  = new Date().toLocaleString('vi-VN',{timeZone:'Asia/Ho_Chi_Minh'});\nvar emailTopic = '[SafeHome] CANH BAO: The RFID khong hop le!';\nvar emailBody = 'CANH BAO XAM NHAP SafeHome\\n'\n            + '========================\\n'\n            + 'Thoi gian : ' + now + '\\n'\n            + 'UID the   : ' + (data.uid || 'UNKNOWN') + '\\n'\n            + 'Ket qua   : DENIED - Khong duoc phep truy cap\\n';\n\nvar emailMsg = {\n    to: ownerEmail,\n    topic: emailTopic,\n    payload: emailBody\n};\n\nvar supaUrl = flow.get('SUPABASE_URL') || 'https://wfkesifcfgajgymipqcd.supabase.co';\nvar anonKey = flow.get('SUPABASE_ANON_KEY') || 'sb_publishable_KDECMGj5-HIlQGGUUrYdHg_7b-VojuY';\n\nvar notifMsg = {\n    url: supaUrl + '/rest/v1/notifications',\n    headers: {\n        'apikey': anonKey,\n        'Authorization': 'Bearer ' + anonKey,\n        'Content-Type': 'application/json',\n        'Prefer': 'return=minimal'\n    },\n    payload: {\n        event_type: 'rfid_invalid',\n        message: 'The RFID khong hop le truy cap vao luc ' + now + ' (UID: ' + (data.uid || 'UNKNOWN') + ')'\n    }\n};\n\nreturn [emailMsg, notifMsg];",
    "outputs": 2,
    "x": 580,
    "y": 100,
    "wires": [
      [
        "email-out"
      ],
      [
        "http-post-notif"
      ]
    ]
  },
