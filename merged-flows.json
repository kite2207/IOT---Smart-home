    "order": 1,
    "width": 0,
    "height": 0,
    "head": "",
    "format": "<template>\n  <div class=\"auth-wrap\">\n    <div class=\"auth-card\">\n      <h1>SAFEHOME</h1>\n      <p class=\"subtitle\">\n        {{ isRegister ? 'Tạo tài khoản mới' : 'Đăng nhập để quản lý ngôi nhà của bạn' }}\n      </p>\n\n      <form @submit.prevent=\"isRegister ? register() : login()\">\n        <label>Họ và tên</label>\n        <input\n          v-if=\"isRegister\"\n          v-model.trim=\"fullName\"\n          type=\"text\"\n          placeholder=\"Nguyễn Văn A\"\n        >\n\n        <label>Email</label>\n        <input\n          v-model.trim=\"email\"\n          type=\"email\"\n          placeholder=\"email@example.com\"\n          required\n        >\n\n        <label>Mật khẩu</label>\n        <input\n          v-model=\"password\"\n          type=\"password\"\n          placeholder=\"Tối thiểu 6 ký tự\"\n          required\n        >\n\n        <template v-if=\"isRegister\">\n          <label>Nhập lại mật khẩu</label>\n          <input\n            v-model=\"rePassword\"\n            type=\"password\"\n            placeholder=\"Nhập lại mật khẩu\"\n            required\n          >\n        </template>\n\n        <p v-if=\"message\" :class=\"success ? 'success' : 'error'\">\n          {{ message }}\n        </p>\n\n        <button type=\"submit\" :disabled=\"loading\">\n          {{ loading ? 'Đang xử lý...' : (isRegister ? 'Đăng ký' : 'Đăng nhập') }}\n        </button>\n      </form>\n\n      <button class=\"link-button\" @click=\"switchForm\">\n        {{ isRegister\n          ? 'Đã có tài khoản? Đăng nhập'\n          : 'Chưa có tài khoản? Đăng ký ngay' }}\n      </button>\n    </div>\n  </div>\n</template>\n\n<script>\nexport default {\n  data() {\n    return {\n      isRegister: false,\n      fullName: '',\n      email: '',\n      password: '',\n      rePassword: '',\n      message: '',\n      success: false,\n      loading: false\n    }\n  },\n\n  methods: {\n    switchForm() {\n      this.isRegister = !this.isRegister\n      this.message = ''\n      this.success = false\n      this.password = ''\n      this.rePassword = ''\n    },\n\n    async login() {\n      await this.callApi('/auth/login', {\n        email: this.email,\n        password: this.password\n      }, true)\n    },\n\n    async register() {\n      if (this.password !== this.rePassword) {\n        this.success = false\n        this.message = 'Mật khẩu nhập lại không khớp.'\n        return\n      }\n\n      await this.callApi('/auth/register', {\n        full_name: this.fullName,\n        email: this.email,\n        password: this.password,\n        re_password: this.rePassword\n      }, false)\n    },\n\n    async callApi(url, body, isLogin) {\n      this.loading = true\n      this.message = ''\n\n      try {\n        const response = await fetch(url, {\n          method: 'POST',\n          headers: { 'Content-Type': 'application/json' },\n          body: JSON.stringify(body)\n        })\n\n        const result = await response.json()\n        this.success = result.ok\n        this.message = result.message || 'Không nhận được phản hồi từ hệ thống.'\n\n        if (isLogin && result.ok && result.access_token) {\n          sessionStorage.setItem('safehome_access_token', result.access_token)\n          sessionStorage.setItem('safehome_user', JSON.stringify(result.user))\n\n          setTimeout(() => {\n            window.location.href = '/dashboard/page2'\n          }, 700)\n        }\n\n        if (!isLogin && result.ok) {\n          this.isRegister = false\n          this.password = ''\n          this.rePassword = ''\n        }\n      } catch (error) {\n        this.success = false\n        this.message = 'Không thể kết nối đến máy chủ Node-RED.'\n      } finally {\n        this.loading = false\n      }\n    }\n  }\n}\n</script>\n\n<style scoped>\n.auth-wrap {\n  min-height: 75vh;\n  display: flex;\n  justify-content: center;\n  align-items: center;\n  padding: 24px;\n  background: #f3f6f8;\n}\n\n.auth-card {\n  width: min(100%, 420px);\n  padding: 32px;\n  border-radius: 16px;\n  background: #ffffff;\n  box-shadow: 0 12px 28px rgba(0, 0, 0, 0.12);\n}\n\nh1 {\n  margin: 0;\n  text-align: center;\n  color: #176b4a;\n  letter-spacing: 2px;\n}\n\n.subtitle {\n  margin: 10px 0 24px;\n  color: #667085;\n  text-align: center;\n}\n\nlabel {\n  display: block;\n  margin: 14px 0 6px;\n  font-weight: 600;\n  color: #344054;\n}\n\ninput {\n  box-sizing: border-box;\n  width: 100%;\n  padding: 12px;\n  border: 1px solid #d0d5dd;\n  border-radius: 8px;\n  font-size: 15px;\n}\n\nbutton {\n  width: 100%;\n  margin-top: 22px;\n  padding: 12px;\n  border: 0;\n  border-radius: 8px;\n  background: #176b4a;\n  color: white;\n  font-size: 16px;\n  font-weight: 600;\n  cursor: pointer;\n}\n\nbutton:disabled {\n  background: #98a2b3;\n  cursor: not-allowed;\n}\n\n.link-button {\n  margin-top: 12px;\n  background: transparent;\n  color: #176b4a;\n}\n\n.error, .success {\n  margin: 14px 0 0;\n  padding: 10px;\n  border-radius: 8px;\n}\n\n.error {\n  background: #fef3f2;\n  color: #b42318;\n}\n\n.success {\n  background: #ecfdf3;\n  color: #027a48;\n}\n</style>",
