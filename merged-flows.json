    "name": "function 5",
    "func": "const rows = msg.payload;\n\nif (!Array.isArray(rows)) {\n    node.error(\"Supabase không trả về mảng dữ liệu\", msg);\n    return null;\n}\n\nconst points = rows.map(row => ({\n    time: new Date(row.recorded_at).getTime(),\n    label: new Date(row.recorded_at).toLocaleTimeString(\"vi-VN\", {\n        hour: \"2-digit\",\n        minute: \"2-digit\"\n    }),\n    temperature: Number(row.temperature),\n    humidity: Number(row.humidity)\n}));\n\nconst temperatureStyle = {\n    ui_update: {\n        chartOptions: {\n            color: [\"#F44336\"],\n            textStyle: {\n                color: \"#000000ff\"\n            },\n            title: {\n                textStyle: {\n                    color: \"#000000ff\"\n                }\n            },\n            legend: {\n                textStyle: {\n                    color: \"#000000ff\"\n                }\n            },\n            xAxis: {\n                axisLabel: { color: \"#000000ff\" },\n                nameTextStyle: { color: \"#000000ff\" }\n            },\n            yAxis: {\n                axisLabel: { color: \"#000000ff\" },\n                nameTextStyle: { color: \"#000000ff\" }\n            },\n            series: [{\n                name: \"Temperature (°C)\",\n                type: \"line\",\n                lineStyle: { color: \"#F44336\" },\n                itemStyle: { color: \"#F44336\" }\n            }]\n        }\n    }\n};\n\nconst humidityStyle = {\n    ui_update: {\n        chartOptions: {\n            color: [\"#2196F3\"],\n            textStyle: { color: \"#000000\" },\n            title: {\n                textStyle: { color: \"#000000\" }\n            },\n            legend: {\n                textStyle: { color: \"#000000ff\" }\n            },\n            xAxis: {\n                axisLabel: { color: \"#000000\" },\n                nameTextStyle: { color: \"#000000\" }\n            },\n            yAxis: {\n                axisLabel: { color: \"#000000\" },\n                nameTextStyle: { color: \"#000000\" }\n            },\n            series: [{\n                name: \"Humidity (%)\",\n                type: \"bar\",\n                itemStyle: { color: \"#2196F3\" }\n            }]\n        }\n    }\n};\n\nconst temperatureData = {\n    topic: \"Temperature (°C)\",\n    action: \"replace\",\n    payload: points\n};\n\nconst humidityData = {\n    topic: \"Humidity (%)\",\n    action: \"replace\",\n    payload: points\n};\n\nreturn [\n    [temperatureStyle, temperatureData],\n    [humidityStyle, humidityData]\n];",
