    "type": "function",
    "z": "tab-email",
    "name": "Check Email Enabled",
    "func": "var enabled = flow.get('emailEnabled');\nif (!enabled) { node.warn('Email TAT. Bat tren dashboard.'); return null; }\nreturn msg;",
