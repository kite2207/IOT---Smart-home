  {
    "id": "fn-supabase-headers",
    "type": "function",
    "z": "tab-supabase",
    "name": "Build Headers",
    "func": "var url  = flow.get('SUPABASE_URL');\nvar key  = flow.get('SUPABASE_ANON_KEY');\nmsg.headers = {\n  'apikey': key,\n  'Authorization': 'Bearer ' + key,\n  'Content-Type': 'application/json',\n  'Prefer': 'return=minimal'\n};\nmsg.url = url + msg._table;\ndelete msg._table;\nreturn msg;",
    "outputs": 1,
    "x": 560,
    "y": 300,
    "wires": [
      [
        "http-post-supabase"
      ]
    ]
  },
